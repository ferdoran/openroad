# Launcher configuration. Copy to .env (gitignored) and fill in your own values;
# every entry is optional and the launcher degrades gracefully when one is unset.

# Community/social links shown in the launcher header. Leave blank to hide.
DISCORD_URL=
YOUTUBE_URL=
COFFEE_URL=
# Shown as the header "Website" link target.
SITE_URL=
# Filename of the client executable this launcher starts.
CLIENT_NAME=openroad_client.exe
# Base URL of a JSON news feed; unset means the launcher shows its built-in notice.
NEWS_JSON_URL=
# Folder holding your own Media.pk2 etc. In dev, prefer setting it on the command
# line: SRO_PATH=/path/to/your/sro make watch-launcher
#SRO_PATH=
