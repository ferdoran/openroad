# Generated by Cargo
# will have compiled files and executables
/target/

# Cargo.lock IS committed: this workspace ships binaries (client, launcher,
# tools), so a reproducible dependency set is wanted — and it makes the
# licence audit (deny.toml / THIRD-PARTY.md) reproducible too.
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

.idea
.idea/*

.DS_Store

.cargo
# local runtime config: holds the PK2 key, gateway host and dev credentials
config.yaml
# per-user persisted UI/video/audio state, written by the client at runtime
user_settings.yaml

.env

.claude/
environment_graphs.txt
tmp_textures/
# decoded SRO client art (extracted from the user's own PK2s) — never commit
interface/
packet_dump/
# SCREENSHOT=<path> output: a frame of this client IS the user's PK2 art (#564)
screenshots/

# Reverse-engineering working material: decompile corpora, address maps, capture
# transcripts, planning and session notes. These are analysis inputs, not results,
# and they are deliberately not published — see CONTRIBUTING.md,
# "What this repository does not publish".
docs/re/
docs/planning/
.local/
.orchestrator/

# Cutscene camera paths are TRANSCRIPTIONS of the original's
# Media/script/intro/<name>.txt — SRO data, and so not committed, exactly as
# tools/src/bin/intro_convert.rs says. Generate your own:
#   cargo run -p tools --bin intro_convert -- --script <Media>/script/intro/<n>.txt \
#       --out assets/intros/<n>.intro
assets/intros/*.intro

# Python bytecode from the scripts/ gate helpers
__pycache__/
*.pyc
